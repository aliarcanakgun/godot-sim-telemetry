[configuration]
entry_symbol = "ac_library_init"
compatibility_minimum = "4.5"
reloadable = true
doc_path = "docs"

[libraries]
windows.debug.x86_64 = "./bin/godot-sim-telemetry.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./bin/godot-sim-telemetry.windows.template_release.x86_64.dll"

[icons]
SimTelemetryManager = "./icon.svg"